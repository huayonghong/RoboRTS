opt_frame {
    odom_frame: "odom"
    map_frame: "map"
}

trajectory_opt {
    teb_autosize: True
    dt_ref: 0.15
    dt_hysteresis: 0.01
    global_plan_overwrite_orientation: true 
    allow_init_with_backwards_motion: false 
    # Attract the trajectory to the A* path (AddViaPointsEdges, enabled in
    # teb_optimal.cpp).  Dense enough to keep the robot on the centred path
    # inside a corridor instead of cutting to the 2 m local goal.
    global_plan_viapoint_sep: 0.3
    via_points_ordered: False
    max_global_plan_lookahead_dist: 2.0
    exact_arc_length: False
    force_reinit_new_goal_dist: 0.8
    feasibility_check_no_poses: 5
    publish_feedback: False
    min_samples: 3
    max_samples: 200
}

kinematics_opt {
    max_vel_x: 0.3
    max_vel_x_backwards: 0.15
    max_vel_y: 0.2
    max_vel_theta: 0.6
    acc_lim_x: 0.5
    acc_lim_y: 0.5
    acc_lim_theta: 1.0
    min_turning_radius: 0
    wheelbase: 0
    cmd_angle_instead_rotvel: false
}

tolerance_opt {
    xy_goal_tolerance: 0.1
    yaw_goal_tolerance: 0.1
    free_goal_vel: False
}

obstacles_opt {
    # Footprint is modelled as POINT (robot half-width 0.14 m), so this is
    # the lateral margin to the live scan obstacles: 0.2 left only 6 cm.
    min_obstacle_dist: 0.3
    # Soft zone beyond min_obstacle_dist (needs to be > min_obstacle_dist for
    # the inflation edge to be added at all, see AddObstacleEdges).
    inflation_dist: 0.5
    include_costmap_obstacles: True
    costmap_obstacles_behind_robot_dist: 0.1
    obstacle_poses_affected: 30
    legacy_obstacle_association: False
    obstacle_association_cutoff_factor: 5.0
    obstacle_association_force_inclusion_factor: 1.5
}

robot_type {
    type: POINT
    robot_vertices {
        x: 0.125
        y: 0.14
    }
    robot_vertices {
        x: -0.125
        y: 0.14
    }
    robot_vertices {
        x: -0.125
        y: -0.14
    }
    robot_vertices {
        x: 0.125
        y: -0.14
    }
}

optimize_info {
    no_inner_iterations: 5
    no_outer_iterations: 4
    optimization_activate: True
    optimization_verbose: False
    penalty_epsilon: 0.1
    weight_max_vel_x: 1
    weight_max_vel_y: 1
    weight_max_vel_theta: 3
    weight_acc_lim_x: 1
    weight_acc_lim_y: 1
    weight_acc_lim_theta: 3
    # Couples the chassis heading to the direction of travel.  The base is
    # omnidirectional (max_vel_y > 0), so nothing else makes TEB rotate: at 1
    # the robot keeps its initial heading and strafes along the path.  1000
    # (= upstream TEB default for a non-holonomic base) makes it turn to face
    # the path tangent; lower to ~100 if it turns too aggressively.
    weight_kinematics_nh: 1000
    weight_kinematics_forward_drive: 1
    weight_kinematics_turning_radius: 0.0
    weight_optimaltime: 1
    weight_obstacle: 50
    weight_inflation: 0.1
    weight_dynamic_obstacle: 10
    weight_viapoint: 10
    weight_adapt_factor: 2.0
    weight_prefer_rotdir: 0
}

